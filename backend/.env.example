# サーバーポート
PORT=3001

# フロントエンドのオリジン（CORS許可）
FRONTEND_URL=http://localhost:5173

# データ保存ディレクトリ（DB・アップロードファイル）
DATA_DIR=./data

# 環境
NODE_ENV=development

# JWT認証シークレット
# 必ず下記コマンドなどで生成した長いランダム値に置き換えること。
# 未設定/既定値のままだと本番(NODE_ENV=production)では起動が中止されます。
#   生成例(Node)      : node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
#   生成例(PowerShell): $b=[byte[]]::new(48);[System.Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b);-join($b|%{$_.ToString('x2')})
#   ※ Get-Random は暗号用途では使わないこと（CSPRNGではないため推測可能）
JWT_SECRET=
# JWTトークンの有効期限
JWT_EXPIRES=8h