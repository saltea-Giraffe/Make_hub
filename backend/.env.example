# ══════════════════════════════════════════════════════════════
#  Make HUB 設定ファイル（backend/.env）
#  このファイルを backend/.env にコピーして使ってください
# ══════════════════════════════════════════════════════════════

# ─── 基本 ─────────────────────────────────────────────────────

# サーバーポート（HTTP）
PORT=3001

# フロントエンドのオリジン（開発時の CORS 許可先）
FRONTEND_URL=http://localhost:5173

# データ保存ディレクトリ（DB・アップロードファイル・証明書）
DATA_DIR=./data

# 環境
NODE_ENV=development

# ─── 認証 ─────────────────────────────────────────────────────

# JWT認証シークレット
# 必ず下記コマンドなどで生成した長いランダム値に置き換えること。
# 未設定/既定値のままだと本番(NODE_ENV=production)では起動が中止されます。
#   生成例(Node)      : node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
#   生成例(PowerShell): $b=[byte[]]::new(48);[System.Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b);-join($b|%{$_.ToString('x2')})
#   ※ Get-Random は暗号用途では使わないこと（CSPRNGではないため推測可能）
JWT_SECRET=

# JWTトークンの有効期限
JWT_EXPIRES=8h

# ─── HTTPS ────────────────────────────────────────────────────

# HTTPS を有効にする（true にすると HTTPS_PORT で待ち受ける）
# HTTPS_ENABLED=false

# HTTPS の待ち受けポート
# HTTPS_PORT=3443

# HTTPS 有効時、HTTP(PORT) へのアクセスを HTTPS へ 301 リダイレクトする。
# false にすると HTTP と HTTPS の両方でアプリを提供します。
# HTTPS_REDIRECT=true

# 正規の証明書を使う場合はファイルパスを指定する。
# 未指定の場合は DATA_DIR/certs に自己署名証明書を自動生成します
# （ブラウザに警告は出ますが通信は暗号化されます）。
# HTTPS_CERT_FILE=C:\path\to\fullchain.pem
# HTTPS_KEY_FILE=C:\path\to\privkey.pem
# HTTPS_CA_FILE=C:\path\to\chain.pem

# 自己署名証明書に追加で含めるホスト名（カンマ区切り）
# localhost と このPCのLAN IP は自動で含まれます
# HTTPS_EXTRA_HOSTS=hub.local,myhost.example.com

# HSTS ヘッダを送る。既定は false。
# 有効にすると、そのホストへの HTTP 接続をブラウザが一定期間拒否するようになります。
# 正規の証明書で恒久的に HTTPS 運用する場合のみ true にしてください。
# HTTPS_HSTS=false

# ─── SSO 共通 ─────────────────────────────────────────────────

# 外部から見たこのサーバーのベースURL。SSO を使う場合は必須。
# IdP に登録するコールバックURLの組み立てに使います。
# PUBLIC_URL=https://hub.example.com

# SSO で初めてログインしたユーザーに与えるロール（admin / user）
# SSO_DEFAULT_ROLE=user

# ─── SSO: OpenID Connect ──────────────────────────────────────

# OIDC_ENABLED=true
# OIDC_ISSUER=https://accounts.google.com
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# 未指定なら PUBLIC_URL + /api/auth/oidc/callback を使います
# OIDC_REDIRECT_URI=
# OIDC_SCOPE=openid profile email
# ログインボタンに表示する文言
# OIDC_LABEL=SSO でログイン
# ユーザー名として使う ID トークンのクレーム
# OIDC_USERNAME_CLAIM=preferred_username
# このクレームに指定の値が含まれるユーザーを管理者にする（任意）
# OIDC_ADMIN_CLAIM=groups
# OIDC_ADMIN_VALUE=hub-admins

# ─── SSO: SAML ────────────────────────────────────────────────

# SAML_ENABLED=true
# IdP のログインURL (SSO Service URL)
# SAML_ENTRY_POINT=https://idp.example.com/sso/saml
# IdP の署名検証用証明書（PEM本体、または改行を除いた Base64 をそのまま1行で）
# SAML_IDP_CERT=
# SP の EntityID。未指定なら PUBLIC_URL + /api/auth/saml/metadata
# SAML_ISSUER=
# 未指定なら PUBLIC_URL + /api/auth/saml/callback
# SAML_CALLBACK_URL=
# SAML_LABEL=SAML でログイン
# ユーザー名・表示名として使う属性名（未指定なら NameID から推測）
# SAML_USERNAME_ATTRIBUTE=
# SAML_DISPLAYNAME_ATTRIBUTE=
# この属性に指定の値が含まれるユーザーを管理者にする（任意）
# SAML_ADMIN_ATTRIBUTE=
# SAML_ADMIN_VALUE=
#
# IdP には GET {PUBLIC_URL}/api/auth/saml/metadata の内容を登録してください。
